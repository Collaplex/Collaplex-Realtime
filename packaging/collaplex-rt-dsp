#!/bin/sh
# Collaplex RT DSP wrapper（PipeWire pipe 插件的命令入口，路径必须纯 ASCII）
export CX_RATE=96000
export CX_SHELF_DB=8
export CX_SHELF_FREQ=250
export CX_SHELF_S=1.79
export CX_AGC_INIT_DB=-18
export CX_AGC=1
export CX_AGC_CEIL=-18.5
export CX_AGC_DZ=2
export CX_AGC_TAU_DOWN=0.15
export CX_AGC_TAU_UP=1.5
export CX_AGC_DET_TAU=1.0
export CX_AGC_BOOST=12
export CX_AGC_CUT=18
export CX_AGC_UP_RATE=6.0
export CX_AGC_DOWN_S=0.08
export CX_AGC_SILENCE_RELEASE=1.5
export CX_AGC_GATE=-70
export CX_AGC_ACTIVATE=-50
export CX_AGC_HYST=3
export CX_AGC_MODE=clip
export CX_CLIP_MEASURE_S=0.6
export CX_CLIP_BOUNDARY_MS=300
export CX_CLIP_BOUNDARY_LUFS=-60
export CX_CLIP_RECHECK_S=0
export CX_VERIFY_DELAY_S=1.3
export CX_VERIFY_RAMP_S=2.0
export CX_VERIFY_DZ=0.5
export CX_DRY_TRANSFER_INIT=-3.0
export CX_GAP_DBFS=-50
export CX_GAP_MS=200
export CX_LIMIT_CEIL=0.891
export CX_DEBUG=0
# 用户覆盖（可选）
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/collaplex-rt/env" ] && \
    . "${XDG_CONFIG_HOME:-$HOME/.config}/collaplex-rt/env"
exec /usr/bin/collaplex-realtime
